---
import WorkSign from './WorkSign.astro';
import LightPollution from '../sky/LightPollution.astro';
import VerticalRail from '../rail/VerticalRail.astro';
import { getPublishedWorks } from '../../lib/works';

/*
  成果物の一覧（看板の列）。

  以前は 3:4 の窓を敷き詰めたグリッドで、うち67%は装飾（暗いだけのセル）だった。
  ただ実際には装飾として機能しておらず、「作品が入っていない枠」に見えていた。
  さらに作品名とサムネイルがホバー時しか出ないため、タッチ端末では
  タップするまで何も分からない状態だった。よって装飾セルは全廃し、
  作品だけを看板として並べる形に変えた（仕様書 §6.1 改訂）。

  見出しは持たず、<slot> でページ側から受け取る。
  このセクションは専用ページ `/works/` の主役なので、見出しは h1 であるべきで、
  それを決められるのはページ側だけだから（仕様書 §5.4）。
*/
const sorted = await getPublishedWorks();

/*
  管の色。看板ごとに割り当てて多色の街にする（§1.2 改訂で紫縛りは撤回）。

  上から 赤 → 橙 → 緑 → 水色 → 紫 の順で回す（§6.4）。
  順番に回すだけなので、リロードしても同じ作品は同じ色になる。
  ランダムにはしない。同じ作品が毎回違う色で光ると、看板ではなく照明になる。
*/
const TUBES = [
  { hue: 'var(--neon-red)', core: 'var(--neon-red-core)' },
  { hue: 'var(--neon-orange)', core: 'var(--neon-orange-core)' },
  { hue: 'var(--neon-green)', core: 'var(--neon-green-core)' },
  { hue: 'var(--neon-cyan)', core: 'var(--neon-cyan-core)' },
  { hue: 'var(--neon-violet)', core: 'var(--neon-violet-core)' },
];
---

{/*
  セクション自体は地を持たない。作品1件を1枚のカードにし（WorkSign の .sign__link.card）、
  カードのあいだから夜景が見えるようにする。ページの見出しと説明もカードに載せる（ページ側）。
  重なり順: 夜景（SiteBackdrop）→ 光害の空（淡い光）→ カード → 看板の文字。
*/}
<section id="works" class="works-section">
  <LightPollution />
  <VerticalRail />

  <div class="works-section__inner">
    <slot />

    <nav aria-label="成果物一覧">
      <ol class="works">
        {
          sorted.map((work, i) => (
            <WorkSign
              work={work}
              index={i}
              hue={TUBES[i % TUBES.length].hue}
              core={TUBES[i % TUBES.length].core}
            />
          ))
        }
      </ol>
    </nav>
  </div>
</section>

<style>
  @layer components {
    .works-section {
      position: relative;
      padding: var(--space-6) var(--card-gutter);
    }

    .works-section__inner {
      position: relative;
      z-index: 1;
      max-width: 64rem;
      margin-inline: auto;
    }

    /* 作品のカードどうしのあいだに夜景を見せる */
    .works {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
    }
  }
</style>

<script>
  // このセクション内のアイランド（看板の点灯 / 光害の空 / 縦組みレール）は
  // まとめて1本のエントリから起動する。コンポーネントごとに <script> を置くと
  // 小さなチャンクが別々のリクエストになり、初期ロードでフォントと帯域を奪い合う。
  //
  // ClientRouter では、この <script> は最初に出会ったときに一度しか評価されない。
  // そのため初期化は Astro のページ遷移のイベントに結び付ける。
  //   - astro:page-load  … 今のページに一覧があれば仕掛ける（直接開いたときも遷移で来たときも）
  //   - astro:before-swap … 離れる前に、仕掛けたものをすべて止める
  // リスナーはモジュールの評価時に一度だけ登録されるので、遷移のたびに増えない。
  import { initIslands, type Cleanup } from '../motion/islands';

  // いま演出を仕掛けているセクションと、その後始末
  let active: { section: HTMLElement; cleanup: Cleanup } | null = null;

  function unmount() {
    active?.cleanup();
    active = null;
  }

  function mount() {
    const section = document.querySelector<HTMLElement>('.works-section');
    // 同じセクションにはもう仕掛けてある（評価時と astro:page-load の両方から呼ばれるため）
    if (active && active.section === section) return;
    unmount();
    if (section) active = { section, cleanup: initIslands(section) };
  }

  document.addEventListener('astro:page-load', mount);
  document.addEventListener('astro:before-swap', unmount);

  // 遷移で初めてこのページに来たとき、評価が astro:page-load の後になることがあるので、
  // 評価時にも一度呼ぶ（すでに仕掛けてあれば何もしない）。
  mount();
</script>
