---
import { Image } from 'astro:assets';
import icon from '../../assets/mawo_icon.png';
import { AUTHOR, SOCIALS } from '../../lib/site';

/*
  プロフィール。トップページの、ヒーローと成果物への入口の間に置く。

  見せ方は「灯っている窓」。サイトの概念（1つの窓 = 1つの中身）をそのまま使い、
  作品ではなく人が入っている窓として提示する。
  アイコンがPCに向かう後ろ姿なので、窓の中を覗いている構図になる。
*/
const role = 'Developer / ML Engineer';

/*
  自己紹介。所属と、いま何をしているか。

  文章ではなく短い事実を並べているので、行間は段落用の余白ではなく
  詰めた値を使う（下の .profile__bio + .profile__bio）。
*/
const bio = [
  '千葉工業大学情報変革科学部認知情報科学科3年',
  '機械学習の研究をしています。',
  'Nekko Cloud所属',
];

/*
  スキル。用途で分類して並べる。

  一列に並べると Python と Docker が同じ粒度に見える。
  「何をするための道具か」で切ると、読む人の知りたいこと
  （この人に何を頼めるのか）に直接答えられる。

  分類は言語ではなく用途で切っている。Flask / FastAPI は Python だが
  用途は Web なので WEB 側、Streamlit は ML の結果を見せる道具なので ML 側。

  ここに書くのは面接で聞かれて答えられるものだけにすること。
  このサイトは実測値しか出さない建て方をしているので、
  スキル欄だけ触った程度のものの全列挙になると、そこだけ質が落ちる。
*/
const skillGroups = [
  { category: 'MACHINE LEARNING', items: ['Python', 'PyTorch', 'Streamlit'] },
  {
    category: 'WEB',
    items: ['TypeScript', 'React', 'Next.js', 'Node.js', 'FastAPI', 'Flask'],
  },
  { category: 'ENVIRONMENT', items: ['Docker'] },
];
---

<section id="profile" class="profile" aria-labelledby="profile-heading">
  <div class="profile__inner">
    {/* 灯っている窓。中にいるのが本人という見立て */}
    <div class="profile__window">
      <Image
        src={icon}
        alt={`${AUTHOR.handleEn} のアイコン`}
        widths={[260, 520]}
        sizes="(min-width: 768px) 260px, 60vw"
        format="avif"
        quality={70}
        loading="lazy"
        class="profile__icon"
      />
    </div>

    <div class="profile__body">
      <h2 class="profile__label font-mono" id="profile-heading">ABOUT</h2>

      {/*
        大きく出すのはハンドル。サイト名（Mawo's Portfolio）と揃う。
        本名はその真下に小さく置く。看板に屋号、その下に正式な名前、という関係。

        和文を .font-mono に入れないこと。--font-mono には和文が無く、
        システムの既定書体に落ちて Zen Kaku と混ざる。
      */}
      <p class="profile__name">
        <span class="profile__name-jp">{AUTHOR.handleJp}</span>
        <span class="profile__name-en font-mono">{AUTHOR.handleEn}</span>
      </p>
      <p class="profile__realname">
        <span class="profile__realname-jp">{AUTHOR.jp}</span>
        <span class="profile__realname-en font-mono">{AUTHOR.en}</span>
      </p>
      <p class="profile__role font-mono">{role}</p>

      {bio.map((line) => <p class="profile__bio">{line}</p>)}

      {/* 分類名は欧文のみ。和文を .font-mono に入れると既定書体に落ちる */}
      <dl class="profile__skills">
        {
          skillGroups.map((group) => (
            <div class="profile__skill-group">
              <dt class="font-mono">{group.category}</dt>
              <dd>
                <ul class="font-mono">
                  {group.items.map((s) => (
                    <li>{s}</li>
                  ))}
                </ul>
              </dd>
            </div>
          ))
        }
      </dl>

      {/*
        アカウント。フッターにも同じものを出しているが、あちらは
        ページ最下部にしかない。ABOUT を読んだ人がその場で辿れるよう、
        自己紹介の終わりにも置く。

        rel="me" を付けているのは、構造化データの sameAs と相互に
        指し合う形にして本人性の裏付けにするため（仕様書 §11）。
      */}
      <div class="profile__links">
        <p class="profile__links-label font-mono">LINKS</p>
        <ul class="font-mono">
          {
            SOCIALS.map((s) => (
              <li>
                <a href={s.href} rel="me noopener noreferrer" target="_blank">
                  {s.label}
                  <span class="profile__links-out" aria-hidden="true">&#8599;</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  @layer components {
    .profile {
      position: relative;
      padding: var(--space-6) var(--space-3) var(--space-5);
      background: var(--c-void);
    }

    .profile__inner {
      display: grid;
      grid-template-columns: 240px 1fr;
      gap: var(--space-5);
      align-items: start;
      /*
        本文を 46ch で畳んでいるので、器を広く取ると右側が間延びする。
        窓と本文が一塊に見える幅で止める。
      */
      max-width: 54rem;
      margin-inline: auto;
    }

    /*
      窓。グリッドのセルと同じ 3:4 / 角丸2px で「同じ建物の窓」に見せる。
      アイコンは正方形の円構図なので cover で切らず contain で収める。
      アイコン自身の地色が --c-facade とほぼ同じ (1,1,21) なので継ぎ目が出ない。
    */
    .profile__window {
      /*
        窓の地色。トークンではなくアイコン画像自身の地色に合わせている。

        アイコンは正方形、窓は 3:4 なので contain すると上下に帯が出る。
        ここを --c-facade にすると、アイコンの地色 rgb(1,1,21) との差
        （約10段階）が帯としてはっきり見えてしまう。画像に合わせて継ぎ目を消す。
        アイコンを差し替えたらこの値も合わせ直すこと。
      */
      --profile-window-bg: rgb(1 1 21);

      aspect-ratio: 3 / 4;
      border-radius: var(--radius-cell);
      background: var(--profile-window-bg);
      display: grid;
      place-items: center;
      overflow: hidden;
      /* 灯っている窓なので、わずかに光を持たせる */
      box-shadow: 0 0 40px -12px color-mix(in srgb, var(--c-signal) 60%, transparent);
    }

    .profile__icon {
      width: 100%;
      height: auto;
      object-fit: contain;
    }

    /* --- 本文 --- */
    .profile__body {
      padding-top: var(--space-1);
    }

    .profile__label {
      color: var(--c-dust);
      font-size: var(--fs-caption);
      font-weight: 400;
      letter-spacing: 0.16em;
      margin-bottom: var(--space-3);
    }

    .profile__name {
      display: flex;
      align-items: baseline;
      gap: var(--space-2);
      flex-wrap: wrap;
    }

    .profile__name-jp {
      font-size: var(--fs-h1);
      font-weight: 700;
      color: var(--c-fluorescent);
      line-height: var(--lh-display);
    }

    .profile__name-en {
      font-size: var(--fs-small);
      color: var(--c-dust);
      letter-spacing: 0.1em;
    }

    /*
      本名。ハンドルより一段落として、同じ人の別表記だと分かる位置に置く。
      和文は --c-fluorescent、ローマ字は --c-dust で、視線の順序を作る。
    */
    .profile__realname {
      display: flex;
      align-items: baseline;
      gap: var(--space-2);
      flex-wrap: wrap;
      margin-top: var(--space-1);
      font-size: var(--fs-small);
    }

    .profile__realname-jp {
      color: var(--c-fluorescent);
      letter-spacing: 0.04em;
    }

    .profile__realname-en {
      color: var(--c-dust);
      letter-spacing: 0.1em;
    }

    .profile__role {
      margin-top: var(--space-1);
      color: var(--c-dust);
      font-size: var(--fs-small);
      letter-spacing: 0.08em;
    }

    /*
      中身は文章ではなく短い事実の列。段落用の余白（space-3）で全行を離すと
      1行ずつが孤立して見えるので、塊の頭だけ空けて中は詰める。
    */
    .profile__bio {
      margin-top: var(--space-3);
      color: var(--c-dust);
      max-width: 46ch;
    }

    .profile__bio + .profile__bio {
      margin-top: var(--space-1);
    }

    .profile__skills {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      margin-top: var(--space-4);
    }

    .profile__skills dt,
    .profile__links-label {
      color: var(--c-dust);
      font-size: var(--fs-caption);
      letter-spacing: 0.16em;
      /* 分類が複数並ぶので、見出しと中身は近づけ、群の間で離す */
      margin-bottom: var(--space-1);
    }

    .profile__skills dd {
      margin-left: 0;
    }

    .profile__skills ul,
    .profile__links ul {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-1) var(--space-2);
      font-size: var(--fs-small);
      color: var(--c-fluorescent);
    }

    /* --- アカウント --- */
    .profile__links {
      margin-top: var(--space-3);
    }

    /*
      スキルの「灯」は使わない。あちらは押せない項目なので、
      同じ形にすると押せるかどうかが見た目で区別できなくなる
      （ホバーでしか差が出ず、タッチ端末では触るまで分からない）。

      作品詳細ページの外部リンク（.work__links）と同じ書き方に揃える。
      枠で囲み、末尾に ↗ を出すのがこのサイトでの「外へ出る」印。
    */
    .profile__links a {
      display: inline-flex;
      align-items: baseline;
      gap: 0.4em;
      padding: 0.3em 0.7em;
      color: var(--c-fluorescent);
      border: 1px solid var(--c-facade-lit);
      border-radius: var(--radius-button);
      transition: border-color var(--dur-base) var(--ease-inout);
    }

    .profile__links a:hover,
    .profile__links a:focus-visible {
      border-color: var(--c-signal);
      transition: border-color var(--dur-fast) var(--ease-out);
    }

    .profile__links-out {
      color: var(--c-dust);
      font-size: 0.9em;
    }

    @media (prefers-reduced-motion: reduce) {
      .profile__links a {
        transition: none;
      }
    }

    /* 技術名の頭に灯を1つ。窓明かりの見立てを小さく反復させる */
    .profile__skills li {
      display: flex;
      align-items: center;
      gap: 0.5em;
    }

    .profile__skills li::before {
      content: '';
      width: 5px;
      height: 7px;
      border-radius: 1px;
      background: var(--c-facade-lit);
      box-shadow: 0 0 8px -2px var(--c-signal);
    }

    @media (max-width: 767px) {
      .profile__inner {
        grid-template-columns: 1fr;
        gap: var(--space-4);
        justify-items: start;
      }

      .profile__window {
        width: 60vw;
        max-width: 260px;
      }
    }
  }
</style>
