---
import { Image } from 'astro:assets';
import icon from '../../assets/mawo_icon.png';
import { AUTHOR, SOCIALS } from '../../lib/site';

/*
  プロフィール。トップページの、ヒーローと成果物への入口の間に置く。

  見せ方は「灯っている窓」。サイトの概念（1つの窓 = 1つの中身）をそのまま使い、
  作品ではなく人が入っている窓として提示する。
  アイコンがPCに向かう後ろ姿なので、窓の中を覗いている構図になる。
*/
const role = 'Developer / ML Engineer';

/*
  自己紹介。所属と、いま何をしているか。

  文章ではなく短い事実を並べているので、行間は段落用の余白ではなく
  詰めた値を使う（下の .profile__bio + .profile__bio）。
*/
const bio = [
  '千葉工業大学情報変革科学部認知情報科学科3年',
  '機械学習の研究をしています。',
  'Nekko Cloud所属',
];

/*
  スキル。用途で分類して並べる。

  一列に並べると Python と Docker が同じ粒度に見える。
  「何をするための道具か」で切ると、読む人の知りたいこと
  （この人に何を頼めるのか）に直接答えられる。

  分類は言語ではなく用途で切っている。Flask / FastAPI は Python だが
  用途は Web なので WEB 側、Streamlit は ML の結果を見せる道具なので ML 側。

  ここに書くのは面接で聞かれて答えられるものだけにすること。
  このサイトは実測値しか出さない建て方をしているので、
  スキル欄だけ触った程度のものの全列挙になると、そこだけ質が落ちる。
*/
const skillGroups = [
  { category: 'MACHINE LEARNING', items: ['Python', 'PyTorch', 'Streamlit'] },
  {
    category: 'WEB',
    items: ['TypeScript', 'React', 'Next.js', 'Node.js', 'FastAPI', 'Flask'],
  },
  { category: 'ENVIRONMENT', items: ['Docker'] },
];

/*
  アカウント（GitHub / X）。ロゴ・サービス名・アカウント名を1つのボタンにまとめる。

  アカウント名は URL から取る。出所を SOCIALS（src/lib/site.ts）の1か所にして、
  表示とリンク先・構造化データの sameAs がずれないようにするため。

  ロゴは単色の SVG を HTML に埋め込み、文字色（currentColor）で塗る。
  2つで 1KB 強なので、画像ファイルにしてリクエストを増やすより安い。
  出典: GitHub は Primer Octicons の mark-github-16（MIT）、X は Simple Icons の x（CC0）。
  形は変えないこと（どちらのブランドガイドラインも、ロゴの変形を認めていない）。
*/
type SocialLabel = (typeof SOCIALS)[number]['label'];
const LOGOS: Record<SocialLabel, { viewBox: string; d: string }> = {
  GitHub: {
    viewBox: '0 0 16 16',
    d: 'M6.766 11.328c-2.063-.25-3.516-1.734-3.516-3.656 0-.781.281-1.625.75-2.188-.203-.515-.172-1.609.063-2.062.625-.078 1.468.25 1.968.703.594-.187 1.219-.281 1.985-.281.765 0 1.39.094 1.953.265.484-.437 1.344-.765 1.969-.687.218.422.25 1.515.046 2.047.5.593.766 1.39.766 2.203 0 1.922-1.453 3.375-3.547 3.64.531.344.89 1.094.89 1.954v1.625c0 .468.391.734.86.547C13.781 14.359 16 11.53 16 8.03 16 3.61 12.406 0 7.984 0 3.563 0 0 3.61 0 8.031a7.88 7.88 0 0 0 5.172 7.422c.422.156.828-.125.828-.547v-1.25c-.219.094-.5.156-.75.156-1.031 0-1.64-.562-2.078-1.609-.172-.422-.36-.672-.719-.719-.187-.015-.25-.093-.25-.187 0-.188.313-.328.625-.328.453 0 .844.281 1.25.86.313.452.64.655 1.031.655s.641-.14 1-.5c.266-.265.47-.5.657-.656',
  },
  X: {
    viewBox: '0 0 24 24',
    d: 'M14.234 10.162 22.977 0h-2.072l-7.591 8.824L7.251 0H.258l9.168 13.343L.258 24H2.33l8.016-9.318L16.749 24h6.993zm-2.837 3.299-.929-1.329L3.076 1.56h3.182l5.965 8.532.929 1.329 7.754 11.09h-3.182z',
  },
};

const accounts = SOCIALS.map((s) => ({
  ...s,
  key: s.label.toLowerCase(),
  handle: `@${new URL(s.href).pathname.replace(/^\/+|\/+$/g, '')}`,
  logo: LOGOS[s.label],
}));
---

<section id="profile" class="profile" aria-labelledby="profile-heading">
  <div class="profile__inner card">
    {/* 灯っている窓。中にいるのが本人という見立て */}
    <div class="profile__window">
      <Image
        src={icon}
        alt={`${AUTHOR.handleEn} のアイコン`}
        widths={[260, 520]}
        sizes="(min-width: 768px) 260px, 60vw"
        format="avif"
        quality={70}
        loading="lazy"
        class="profile__icon"
      />
    </div>

    <div class="profile__body">
      <h2 class="profile__label font-mono" id="profile-heading">ABOUT</h2>

      {/*
        大きく出すのはハンドル。サイト名（Mawo's Portfolio）と揃う。
        本名はその真下に小さく置く。看板に屋号、その下に正式な名前、という関係。

        和文を .font-mono に入れないこと。--font-mono には和文が無く、
        システムの既定書体に落ちて Zen Kaku と混ざる。
      */}
      <p class="profile__name">
        <span class="profile__name-jp">{AUTHOR.handleJp}</span>
        <span class="profile__name-en font-mono">{AUTHOR.handleEn}</span>
      </p>
      <p class="profile__realname">
        <span class="profile__realname-jp">{AUTHOR.jp}</span>
        <span class="profile__realname-en font-mono">{AUTHOR.en}</span>
      </p>
      <p class="profile__role font-mono">{role}</p>

      {bio.map((line) => <p class="profile__bio">{line}</p>)}

      {/* 分類名は欧文のみ。和文を .font-mono に入れると既定書体に落ちる */}
      <dl class="profile__skills">
        {
          skillGroups.map((group) => (
            <div class="profile__skill-group">
              <dt class="font-mono">{group.category}</dt>
              <dd>
                <ul class="font-mono">
                  {group.items.map((s) => (
                    <li>{s}</li>
                  ))}
                </ul>
              </dd>
            </div>
          ))
        }
      </dl>

      {/*
        アカウント。フッターにも同じものを出しているが、あちらは
        ページ最下部にしかない。ABOUT を読んだ人がその場で辿れるよう、
        自己紹介の終わりにも置く。

        rel="me" を付けているのは、構造化データの sameAs と相互に
        指し合う形にして本人性の裏付けにするため（仕様書 §11）。
      */}
      <div class="profile__links">
        <p class="profile__links-label font-mono">LINKS</p>
        <ul class="profile__accounts">
          {
            accounts.map((a) => (
              <li>
                <a
                  class={`profile__account profile__account--${a.key} font-mono`}
                  href={a.href}
                  rel="me noopener noreferrer"
                  target="_blank"
                >
                  <svg
                    class="profile__account-logo"
                    viewBox={a.logo.viewBox}
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path d={a.logo.d} />
                  </svg>
                  <span class="profile__account-name">{a.label}</span>
                  <span class="profile__account-handle">{a.handle}</span>
                  <span class="profile__account-out" aria-hidden="true">
                    &#8599;
                  </span>
                  <span class="profile__account-tube neon-tube" aria-hidden="true" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  @layer components {
    /*
      セクション自体は地を持たない。プロフィール全体（窓・名前・紹介文・スキル・リンク）を
      1枚のカードに載せ、その外側に夜景を見せる。中をさらにカードに割らない。
    */
    .profile {
      position: relative;
      padding: var(--space-6) var(--card-gutter) var(--space-5);
    }

    .profile__inner {
      display: grid;
      grid-template-columns: 240px 1fr;
      gap: var(--space-5);
      align-items: start;
      /*
        本文を 46ch で畳んでいるので、器を広く取ると右側が間延びする。
        窓と本文が一塊に見える幅（中身 54rem）で止める。カードの内側の余白はその外に足す。
      */
      max-width: calc(54rem + var(--card-pad) * 2);
      margin-inline: auto;
    }

    /*
      窓。グリッドのセルと同じ 3:4 / 角丸2px で「同じ建物の窓」に見せる。
      アイコンは正方形の円構図なので cover で切らず contain で収める。
      アイコン自身の地色が --c-facade とほぼ同じ (1,1,21) なので継ぎ目が出ない。
    */
    .profile__window {
      /*
        窓の地色。トークンではなくアイコン画像自身の地色に合わせている。

        アイコンは正方形、窓は 3:4 なので contain すると上下に帯が出る。
        ここを --c-facade にすると、アイコンの地色 rgb(1,1,21) との差
        （約10段階）が帯としてはっきり見えてしまう。画像に合わせて継ぎ目を消す。
        アイコンを差し替えたらこの値も合わせ直すこと。
      */
      --profile-window-bg: rgb(1 1 21);

      aspect-ratio: 3 / 4;
      border-radius: var(--radius-cell);
      background: var(--profile-window-bg);
      display: grid;
      place-items: center;
      overflow: hidden;
      /* 灯っている窓なので、わずかに光を持たせる */
      box-shadow: 0 0 40px -12px color-mix(in srgb, var(--c-signal) 60%, transparent);
    }

    .profile__icon {
      width: 100%;
      height: auto;
      object-fit: contain;
    }

    /* --- 本文 --- */
    .profile__body {
      padding-top: var(--space-1);
    }

    .profile__label {
      color: var(--c-dust);
      font-size: var(--fs-caption);
      font-weight: 400;
      letter-spacing: 0.16em;
      margin-bottom: var(--space-3);
    }

    .profile__name {
      display: flex;
      align-items: baseline;
      gap: var(--space-2);
      flex-wrap: wrap;
    }

    .profile__name-jp {
      font-size: var(--fs-h1);
      font-weight: 700;
      color: var(--c-fluorescent);
      line-height: var(--lh-display);
    }

    .profile__name-en {
      font-size: var(--fs-small);
      color: var(--c-dust);
      letter-spacing: 0.1em;
    }

    /*
      本名。ハンドルより一段落として、同じ人の別表記だと分かる位置に置く。
      和文は --c-fluorescent、ローマ字は --c-dust で、視線の順序を作る。
    */
    .profile__realname {
      display: flex;
      align-items: baseline;
      gap: var(--space-2);
      flex-wrap: wrap;
      margin-top: var(--space-1);
      font-size: var(--fs-small);
    }

    .profile__realname-jp {
      color: var(--c-fluorescent);
      letter-spacing: 0.04em;
    }

    .profile__realname-en {
      color: var(--c-dust);
      letter-spacing: 0.1em;
    }

    .profile__role {
      margin-top: var(--space-1);
      color: var(--c-dust);
      font-size: var(--fs-small);
      letter-spacing: 0.08em;
    }

    /*
      中身は文章ではなく短い事実の列。段落用の余白（space-3）で全行を離すと
      1行ずつが孤立して見えるので、塊の頭だけ空けて中は詰める。
      読ませる紹介文なので、色は本文（仕様書 §5.1 (b)）。
    */
    .profile__bio {
      margin-top: var(--space-3);
      color: var(--c-text);
      max-width: 46ch;
    }

    .profile__bio + .profile__bio {
      margin-top: var(--space-1);
    }

    .profile__skills {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      margin-top: var(--space-4);
    }

    .profile__skills dt,
    .profile__links-label {
      color: var(--c-dust);
      font-size: var(--fs-caption);
      letter-spacing: 0.16em;
      /* 分類が複数並ぶので、見出しと中身は近づけ、群の間で離す */
      margin-bottom: var(--space-1);
    }

    .profile__skills dd {
      margin-left: 0;
    }

    .profile__skills ul {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-1) var(--space-2);
      font-size: var(--fs-small);
      color: var(--c-fluorescent);
    }

    /* --- アカウント（GitHub / X） --- */
    .profile__links {
      margin-top: var(--space-3);
    }

    /*
      GitHub / X は、下辺にネオン管を持つボタンにする（2026-11-03、#55）。
      小さな等幅文字と細い枠だけでは、暗いカードの上で目立たなかった。
      作品詳細の外部リンク（.work__links）は控えめなまま、ここだけ特別扱いにしている。

      - 大きさは小さめのまま。色で目立たせる（枠に管の色を混ぜ、ロゴを管の芯の色に）
      - 管の色は入口の看板と同じく、GitHub が紫、X が水色
      - 管は neon.css の .neon-tube（仕様書 §6.4 の描き方）。文字は発光に頼らない
      - .card にはしない（プロフィールは全体で1枚のカード。仕様書 §5.1 (b)）

      スキルの「灯」は使わない。あちらは押せない項目なので、同じ形にすると
      押せるかどうかが見た目で区別できなくなる。末尾の ↗ がこのサイトでの「外へ出る」印。
    */
    .profile__accounts {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
    }

    .profile__account--github {
      --neon-hue: var(--neon-violet);
      --neon-core: var(--neon-violet-core);
    }

    .profile__account--x {
      --neon-hue: var(--neon-cyan);
      --neon-core: var(--neon-cyan-core);
    }

    .profile__account {
      position: relative;
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0.6rem 1.1rem 0.65rem;
      /* 見比べて決めた 14px。--fs-small がこの値になったのでトークンを使う（#61） */
      font-size: var(--fs-small);
      font-weight: 500;
      line-height: 1.4;
      color: var(--c-fluorescent);
      background: color-mix(in srgb, var(--c-facade) 92%, transparent);
      border: 1px solid
        color-mix(
          in srgb,
          var(--neon-hue) 30%,
          color-mix(in srgb, var(--c-fluorescent) 16%, transparent)
        );
      border-radius: var(--radius-panel);
    }

    .profile__account-logo {
      flex: none;
      width: 1rem;
      height: 1rem;
      fill: currentColor;
      color: var(--neon-core);
    }

    /* アカウント名は補助情報だが、暗いグレーでは読みにくかったので本文の色にする */
    .profile__account-handle {
      color: var(--c-text);
      font-weight: 400;
    }

    .profile__account-out {
      color: var(--c-text);
      font-size: var(--fs-small);
      transition:
        transform var(--dur-base) var(--ease-inout),
        color var(--dur-base) var(--ease-inout);
    }

    /*
      下辺の管。普段は中央だけ弱く灯り、ホバー・フォーカスで左右へ伸びて明るくなる。
      発光の強さ（--neon-strength）は管自身に持たせ、ボタン全体では変化させない。
      両端は芯の色を透明へ落として、管の端が四角く切れて見えないようにする。
    */
    .profile__account-tube {
      --neon-strength: 0.6;

      position: absolute;
      left: 14%;
      right: 14%;
      bottom: -1px;
      height: 2px;
      border-radius: 2px;
      background: linear-gradient(
        90deg,
        transparent,
        var(--neon-core) 25%,
        var(--neon-core) 75%,
        transparent
      );
      pointer-events: none;
      transition:
        left var(--dur-base) var(--ease-inout),
        right var(--dur-base) var(--ease-inout),
        --neon-strength var(--dur-base) var(--ease-inout);
    }

    .profile__account:hover .profile__account-tube,
    .profile__account:focus-visible .profile__account-tube {
      --neon-strength: 1.15;
      left: 2%;
      right: 2%;
      transition:
        left var(--dur-fast) var(--ease-out),
        right var(--dur-fast) var(--ease-out),
        --neon-strength var(--dur-fast) var(--ease-out);
    }

    .profile__account:hover .profile__account-out,
    .profile__account:focus-visible .profile__account-out {
      transform: translate(2px, -2px);
      color: var(--c-fluorescent);
      transition:
        transform var(--dur-fast) var(--ease-out),
        color var(--dur-fast) var(--ease-out);
    }

    @media (prefers-reduced-motion: reduce) {
      .profile__account-tube,
      .profile__account:hover .profile__account-tube,
      .profile__account:focus-visible .profile__account-tube,
      .profile__account-out,
      .profile__account:hover .profile__account-out,
      .profile__account:focus-visible .profile__account-out {
        transition: none;
      }

      .profile__account:hover .profile__account-out,
      .profile__account:focus-visible .profile__account-out {
        transform: none;
      }
    }

    /* 技術名の頭に灯を1つ。窓明かりの見立てを小さく反復させる */
    .profile__skills li {
      display: flex;
      align-items: center;
      gap: 0.5em;
    }

    .profile__skills li::before {
      content: '';
      width: 5px;
      height: 7px;
      border-radius: 1px;
      background: var(--c-facade-lit);
      box-shadow: 0 0 8px -2px var(--c-signal);
    }

    @media (max-width: 767px) {
      .profile__inner {
        grid-template-columns: 1fr;
        gap: var(--space-4);
        justify-items: start;
      }

      .profile__window {
        width: 60vw;
        max-width: 260px;
      }
    }
  }
</style>
