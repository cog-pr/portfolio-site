---
/*
  経歴。トップページの、プロフィールと成果物への入口の間に置く。

  中央に線を1本通し、その左右へ交互に項目を振る年表。
  振り分けは CSS の配置だけで行い、HTML の順序は時系列のまま触らない。
  見た目が左右に散っても、読み上げとキーボードの順序は上から下で一定になる。

  狭い画面では交互にしない。375px で左右に割ると1カラム150px ほどしか取れず、
  日付も本文も折り返しだらけになる。線を左端へ寄せ、全項目を右側へ積む。
*/
const timeline = [
  {
    date: '2024.04',
    datetime: '2024-04',
    title: '千葉工業大学 入学',
    body: '千葉工業大学 情報変革科学部 認知情報科学科 １期生として入学。',
  },
  {
    date: '2025.12',
    datetime: '2025-12',
    title: '歩きスマホ検知アプリ（大学実験）',
    body: '大学の実験で機械学習による歩きスマホの検知を行い、Accuracy97％の精度の機械学習モデルを作成。',
  },
  {
    date: '2026.04',
    datetime: '2026-04',
    title: 'Progateハッカソン powered by AWS',
    body: 'ハッカソン初参加。Next.jsでフロントエンドの開発を担当。Git・GitHubの使い方をAWSの社員の方から学ぶ。',
  },
  {
    date: '2026.06',
    datetime: '2026-06',
    title: 'Nekko Cloud Team 入部',
    body: 'Twitterでcyokozaiさんに出会い、技術系サークルに入部する。',
  },
  {
    date: '2026.07',
    datetime: '2026-07',
    title: '第10回ツクってアソぶハッカソン',
    body: '大学の友達を誘って参加し、ファイナリストに選出。',
  },
  {
    date: '2026.07',
    datetime: '2026-07',
    title: 'Progateハッカソン 2026.07',
    body: 'FastAPIでバックエンドの開発を担当。',
  },
  {
    date: '2026.08',
    datetime: '2026-08',
    title: 'Findy Campus Hackathon #2',
    body: 'TypeScriptとHono、Cloudflareの機能を駆使し、「WakeMate」を開発。グランプリ＆dip賞を受賞。',
  },
];
---

<section class="career" aria-labelledby="career-heading">
  <div class="career__inner">
    <h2 class="career__label font-mono" id="career-heading">CAREER</h2>

    <ol class="timeline">
      {
        timeline.map((item, i) => (
          /*
            --i で行番号を明示する。デスクトップでは列を左右に振るため、
            指定が無いと自動配置が1行に2件詰めてしまい、段違いにならない。
          */
          <li class="timeline__item card" style={`--i: ${i + 1}`}>
            <time class="timeline__date font-mono" datetime={item.datetime}>
              {item.date}
            </time>
            <h3 class="timeline__title">{item.title}</h3>
            <p class="timeline__body">{item.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  @layer components {
    /*
      セクション自体は地を持たない。経歴1件を1枚のカードにし（.timeline__item.card）、
      カードとカードのあいだ、線の左右から夜景が見えるようにする。
    */
    .career {
      position: relative;
      padding: 0 var(--card-gutter) var(--space-5);
    }

    .career__inner {
      max-width: 54rem;
      margin-inline: auto;
    }

    /*
      節の見出しは夜景の上に直接載る。写真の明るい箇所に重なっても読めるよう、
      字の周りだけを暗くする影を付ける（光らせるためのグローではない）。
    */
    .career__label {
      color: var(--c-dust);
      font-size: var(--fs-caption);
      font-weight: 400;
      letter-spacing: 0.16em;
      margin-bottom: var(--space-4);
      text-shadow:
        0 0 6px var(--c-void),
        0 0 12px var(--c-void);
    }

    /*
      線と節点の位置は、この2つの変数から導く。
      個別に px を書くと、余白を変えたときに節点だけ線から外れる。
    */
    /*
      縦の間隔（row-gap）はカードどうしのあいだ。デスクトップでは1件ごとに
      独立した行を作る（grid-row: var(--i)）ので、この値がそのまま件と件の間隔になる。
      夜景が見える隙間は残しつつ、年表を間延びさせない値にする。
      列のあいだ（column-gap）はデスクトップで --rail が受け持つ。
    */
    .timeline {
      --line-x: 3px; /* 線の中心X（狭い画面では左端） */
      --rail: var(--space-4); /* 線と本文のあいだ */

      position: relative;
      display: grid;
      row-gap: var(--space-3);
      padding-left: var(--rail);
    }

    /* 線。上下は透明へ溶かす。切り落とすと定規のように見えるため */
    .timeline::before {
      content: '';
      position: absolute;
      top: 0.3rem;
      bottom: 0.3rem;
      left: var(--line-x);
      width: 1px;
      transform: translateX(-50%);
      /*
        線は夜景の上に直接引かれる（カードのあいだを通る）。--c-facade-lit では
        写真の暗部に沈んで見えなくなったので、ネオンの紫を半分ほど透かした色にする。
      */
      background: linear-gradient(
        to bottom,
        transparent,
        color-mix(in srgb, var(--neon-violet) 55%, transparent) 6%,
        color-mix(in srgb, var(--neon-violet) 55%, transparent) 94%,
        transparent
      );
    }

    .timeline__item {
      position: relative;
    }

    /*
      節点。プロフィールのスキル欄と同じ「窓明かり」の形を、線の上で灯った窓として置く。
      夜景の上では消灯した窓（--c-facade-lit）だと見えないので、芯を明るい紫にする。
    */
    .timeline__item::before {
      content: '';
      position: absolute;
      /* カードの内側の余白ぶん下げて、日付の行の高さにそろえる */
      top: calc(var(--card-pad) + 0.45em);
      left: calc(var(--line-x) - var(--rail) - 2.5px);
      width: 5px;
      height: 7px;
      border-radius: 1px;
      background: var(--neon-violet-core);
      box-shadow: 0 0 8px var(--neon-violet);
    }

    /* 日付は補助情報、題は見出し、説明は本文（仕様書 §5.1 (c)） */
    .timeline__date {
      color: var(--c-dust);
      font-size: var(--fs-caption);
      letter-spacing: 0.1em;
    }

    /* 説明文より小さいと見出しに見えないので、本文と同じ大きさにして太さと色で分ける */
    .timeline__title {
      margin-top: 0.2rem;
      color: var(--c-fluorescent);
      font-size: var(--fs-body);
      font-weight: 700;
      line-height: 1.6;
    }

    .timeline__body {
      margin-top: 0.35rem;
      color: var(--c-text);
      font-size: var(--fs-body);
      line-height: 1.9;
    }

    /*
      768px 以上で交互に振る。
      行番号（--i）を明示しているので、左右どちらの列でも段がずれない。
    */
    @media (min-width: 768px) {
      .timeline {
        --line-x: 50%;
        --rail: var(--space-5);

        grid-template-columns: 1fr 1fr;
        column-gap: var(--rail);
        padding-left: 0;
      }

      .timeline__item {
        grid-row: var(--i);
      }

      /*
        カードを左右へ振る。カードの中の文字は左揃えのまま
        （右揃えの和文の段落は、カードの中では行頭がそろわず読みにくい）。
      */
      .timeline__item:nth-child(odd) {
        grid-column: 1;
      }

      .timeline__item:nth-child(even) {
        grid-column: 2;
      }

      /*
        節点は列の内側の端へ。列間（--rail）の中央に線があるので、
        その半分ぶん外へ出せば線の上に乗る。
      */
      .timeline__item:nth-child(odd)::before {
        left: auto;
        right: calc(var(--rail) / -2 - 2.5px);
      }

      .timeline__item:nth-child(even)::before {
        left: calc(var(--rail) / -2 - 2.5px);
      }
    }
  }
</style>
