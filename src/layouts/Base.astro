---
// スタイルは必ずコンポーネントのimportより先に読み込むこと。
// Viteはモジュールグラフを深さ優先で辿ってCSSをバンドルするため、
// 先に import したコンポーネント側の `@layer components` が
// reset/base より前にバンドルされ、@layer の優先順位
// （reset, base, components, utilities の順）が崩れてしまう。
import '../styles/layers.css';
import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/fonts-jp.generated.css';
import '../styles/reset.css';
import '../styles/base.css';
import '../styles/neon.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { SITE_NAME, AUTHOR, SOCIALS, CONTACT_EMAIL } from '../lib/site';

interface Props {
  title: string;
  description: string;
  /*
    このページのLCP要素が必要とする追加フォント。
    ページによってLCP要素の書体が違うため（トップは欧文の大見出し、
    「このサイトについて」は和文の導入文）、共通で全部 preload はしない。
    無関係な書体を足すと帯域を奪い合ってかえって遅くなる（実測済み）。
  */
  preloadFonts?: string[];
  /*
    構造化データ（JSON-LD）を出すかどうか。
    Person / WebSite は「サイトと運営者そのもの」を説明するものなので、
    全ページに重複して出さずトップだけに置く。
  */
  siteJsonLd?: boolean;
}

const { title, description, preloadFonts = [], siteJsonLd = false } = Astro.props;
const siteName = SITE_NAME;

/*
  タブに出る文字列。「ページ名 | サイト名」で組むが、
  トップのようにページ名がサイト名そのものの場合は繰り返さない
  （「Mawo's Portfolio | Mawo's Portfolio」になるため）。
*/
const pageTitle = title === siteName ? siteName : `${title} | ${siteName}`;

// SNSやチャットに貼られたときのカード表示に使う絶対URL。
// Astro.site（astro.config.mjs の site）が基準なので、公開先が変わったらそちらを直す。
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.jpg', Astro.site);

/*
  構造化データ。

  狙いは「このドメインが本人の公式サイトである」と検索エンジンに示すこと。
  sameAs で GitHub / X と紐付けるのがその要で、同名のリポジトリなど
  他所のページと取り違えられるのを防ぐ。

  書くのは検証できる事実だけにする（名前・URL・アカウント・連絡先）。
  肩書きのような主観的な情報は、サイト本文で述べれば足りる。
*/
const siteUrl = new URL('/', Astro.site).href;
const personId = `${siteUrl}#person`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      /*
        name は本名、alternateName にローマ字表記とハンドルを並べる。

        画面で大きく見せているのはハンドルだが、ここは機械に「同じ人物の
        別表記」を教える欄なので、全部を1つの Person に集約する。
        本名で検索されてもハンドルで検索されても同じ人に行き着くようにする狙い
        （§11: 示すべきは集客の文句ではなく同一性）。
      */
      '@type': 'Person',
      '@id': personId,
      name: AUTHOR.jpPlain,
      alternateName: [AUTHOR.en, AUTHOR.handleJp, AUTHOR.handleEn],
      url: siteUrl,
      email: `mailto:${CONTACT_EMAIL}`,
      sameAs: SOCIALS.map((s) => s.href),
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      name: siteName,
      url: siteUrl,
      inLanguage: 'ja',
      author: { '@id': personId },
      publisher: { '@id': personId },
    },
  ],
};
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonical} />

    {/* favicon.svg が主。ico は非対応ブラウザ向けの保険。 */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {/*
      SNS・チャットに貼られたときのカード表示。
      ポートフォリオのURLは人に送られる前提なので、無いと味気ない表示になる。
      og:image は絶対URLでないと読まれないクローラーがある。
    */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="夜の都市を背景にしたサイトタイトル WINDOWS AT NIGHT" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {/*
      @font-face は（インライン化した）CSS内にしかないため、preload しないと
      CSSのパースが終わるまでフォント取得が始まらず、その分 LCP が遅れる。

      共通で先読みするのは、欧文のLCP要素に使う Archivo だけ。
      ページ固有のLCP要素に別の書体が必要なら preloadFonts で明示する。
      IBM Plex Mono まで共通で足すと帯域を奪い合い、LCP が悪化した
      （実測: 最悪値 1980ms → 2054ms）。
    */}
    <link
      rel="preload"
      href="/fonts/Archivo-display.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {
      preloadFonts.map((href) => (
        <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
      ))
    }
    {
      siteJsonLd && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(jsonLd)}
        />
      )
    }
    <ClientRouter />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
