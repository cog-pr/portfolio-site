---
import Base from '../layouts/Base.astro';
---

<Base
  title="404"
  description="お探しのページは見つかりませんでした。"
>
  <section class="notfound card">
    <p class="notfound__code font-display">404</p>
    <h1 class="notfound__title">ページが見つかりません</h1>
    <p class="notfound__body">
      お探しのページは、URLが変更されたか、
      もともと存在しないアドレスの可能性があります。
    </p>
    <a href="/" class="notfound__back font-mono">&larr; トップへ戻る</a>
  </section>
</Base>

<style>
  @layer components {
    /*
      本文のまとまりを1枚のカード（.card）にし、周りに夜景を見せる。
      画面の高さいっぱいには広げず、上下に夜景をあけて置く。
    */
    .notfound {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
      width: min(
        72ch - var(--space-3) * 2 + var(--card-pad) * 2,
        100% - var(--card-gutter) * 2
      );
      margin: max(calc(var(--space-5) + var(--space-3)), 22svh) auto var(--space-6);
    }

    /*
      番号はアクセントの紫で示す。--c-signal をそのまま文字色にするとカードの上で
      約 2.3:1 しか出ず読みにくいので、ネオンの紫とその芯（--neon-violet-core）の中間まで
      明るくする。404 は看板ではないのでネオンのグローは付けない（§6.4）。
    */
    .notfound__code {
      font-size: var(--fs-display);
      line-height: 1;
      color: color-mix(in srgb, var(--neon-violet) 50%, var(--neon-violet-core));
    }

    .notfound__title {
      font-size: var(--fs-h2);
      color: var(--c-fluorescent);
    }

    .notfound__body {
      color: var(--c-text);
    }

    .notfound__back {
      margin-top: var(--space-3);
      color: var(--c-dust);
      font-size: var(--fs-small);
    }

    .notfound__back:hover,
    .notfound__back:focus-visible {
      color: var(--c-fluorescent);
    }
  }
</style>
