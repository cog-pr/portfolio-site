---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import metrics from '../data/metrics.json';

// 意思決定ログは時系列（古い順）。判断がどう積み上がったかを読ませるため。
const notes = (await getCollection('notes')).sort(
  (a, b) => a.data.date.valueOf() - b.data.date.valueOf()
);
const renderedNotes = await Promise.all(
  notes.map(async (note) => ({ note, Content: (await render(note)).Content }))
);

const budgets = [
  { label: 'Performance', value: metrics.scores.performance, target: '95 以上', unit: '' },
  { label: 'Accessibility', value: metrics.scores.accessibility, target: '100', unit: '' },
  { label: 'Best Practices', value: metrics.scores.bestPractices, target: '100（警告）', unit: '' },
  { label: 'SEO', value: metrics.scores.seo, target: '100（警告）', unit: '' },
];

const vitals = [
  {
    label: 'LCP',
    value: (metrics.vitals.lcpMs / 1000).toFixed(2),
    unit: 's',
    target: '2.0s 以下',
  },
  { label: 'CLS', value: metrics.vitals.cls.toFixed(3), unit: '', target: '0.05 以下' },
  { label: 'TBT', value: String(metrics.vitals.tbtMs), unit: 'ms', target: '200ms 以下' },
  {
    label: '初期JS (gzip)',
    value: (metrics.budget.initialJsGzipBytes / 1024).toFixed(1),
    unit: 'KB',
    target: '30KB 以下（設計）',
  },
  {
    label: 'フォント合計',
    value: (metrics.budget.fontsBytes / 1024).toFixed(1),
    unit: 'KB',
    target: '200KB 以下',
  },
];

/*
  技術スタック。採用理由まで書く。
  「何を使ったか」だけならpackage.jsonを見れば分かるので、
  このページの価値は「なぜそれを選んだか」にある。
*/
const stack = [
  {
    category: 'フレームワーク',
    items: [
      {
        name: 'Astro',
        note: '静的HTMLを先に出し、必要な演出だけをクライアント側へ載せる。作品と意思決定ログは Markdown の Content Collections として管理し、ビルド時に検証している。',
      },
      {
        name: 'TypeScript (strict)',
        note: '演出の中身まで型を通す。React / Vue などのUIランタイムは加えず、Astro コンポーネントと素の TypeScript で実装している。',
      },
    ],
  },
  {
    category: '見た目',
    items: [
      {
        name: '素のCSS + カスケードレイヤー',
        note: 'Tailwind は使わない。デザイントークンを一次情報として持ちたかったのと、ユーティリティクラスの羅列ではこのページで説明しづらいため。',
      },
      {
        name: 'Archivo / Zen Kaku Gothic New / IBM Plex Mono',
        note: '全てセルフホスト。Google Fonts への実行時接続はしない（third-party接続はLCPを悪化させる）。',
      },
    ],
  },
  {
    category: '演出',
    items: [
      {
        name: 'GSAP + ScrollTrigger',
        note: '看板の点灯シーケンスと縦看板のパララックスに限定して使う。最初の操作か2.5秒経過まで取得を待ち、reduced-motion では取得しない。',
      },
      {
        name: 'OGL',
        note: '背景シェーダー1枚に必要な処理だけを扱える薄い WebGL ラッパー。GPUを使えない環境では初期化せず、CSSの背景を残す。',
      },
    ],
  },
  {
    category: '配信',
    items: [
      {
        name: 'Cloudflare Workers (Static Assets)',
        note: 'Worker スクリプトを持たないアセットのみの構成。公開URLは mawo.dev に一本化し、PR用のプレビューURLだけを残している。',
      },
      {
        name: 'GitHub Actions + Lighthouse CI',
        note: 'PRでは4ページを計測して予算を検証する。main 更新後はトップを再計測し、このページが読む実測値とフォントのサブセットを自動更新する。',
      },
    ],
  },
];

/*
  こだわり・工夫。
  実装中に実際に踏んだ問題と、その対処を書く。
  一般論ではなく、このサイトで測って決めたことだけを載せる。
*/
const craft = [
  {
    title: "GPUが無い環境では背景シェーダーを動かさない",
    body: "WebGLがCPU描画に落ちると、全画面のシェーダーを毎フレーム解くことになる。CIで Performance 0.71 / TBT 2180ms まで落ちた。描画元を見て初期化をやめ、CSSのグラデーションに任せている。",
  },
  {
    title: "欧文は1ウェイトに固定する",
    body: "可変フォント（20.1KB）もウェイト別2ファイルも、LCPを 1.86s → 2.10s に悪化させた。wdth 80 / wght 700 の単一インスタンス 9.3KB で固定している。",
  },
  {
    title: "和文を入口用と残りに分ける",
    body: "1ファイルにまとめると、トップがこのページの長文で使う字まで読み込む。unicode-range で core / ext に分割した。境界は実測で決めている。",
  },
  {
    title: "演出は本文を配り終えてから取りに行く",
    body: "GSAP と OGL は動的 import。さらに最初の操作か2.5秒経過まで、読み込みの判定自体を始めない。先に走らせたときは LCP が 1887〜2036ms の幅で振れた。",
  },
  {
    title: "光の上でもコントラストを実測する",
    body: "グローは背景を明るくするので、文字との比が下がる。ヘッダーのナビが青いネオンの上で 3.30:1 まで落ちていた（基準は 4.5:1）。文字を消した画面と比べて確かめている。",
  },
  {
    title: "点灯の間隔は手で詰める",
    body: "看板は 0.09 秒ずつずらして点灯させ、1枚あたり 0.14 秒で立ち上げてから 0.34 秒かけて微光へ落とす。速すぎると一斉に光って見え、遅いと焦れる。数式ではなく目で決めた。",
  },
  {
    title: "計測は本番と同じ圧縮条件で行う",
    body: "astro preview は無圧縮で配るため、そのまま測ると本番より悪い値が出る。gzip を返す静的サーバーを用意し、手元とCIで同じ条件にしている。",
  },
  {
    title: "窓グリッドをやめて看板にした",
    body: "当初は3:4の窓を敷き詰め、作品名はホバー時だけ出していた。タッチ端末には hover が無く、触るまで中身が分からない。1作品 = 1枚の看板に変え、名前と姿を常に見せている。",
  },
];


const measuredAt = new Date(metrics.measuredAt).toLocaleString('ja-JP', {
  timeZone: 'Asia/Tokyo',
  dateStyle: 'medium',
  timeStyle: 'short',
});
---

<Base
  title="About This Site"
  description="Mawo's Portfolio の現行構成、実測値、仕様変更を含む意思決定の記録。"
  preloadFonts={[
    /*
      このページのLCP要素は導入文（和文）。data-font-core で core 側に寄せ、
      ext の到着を待たせないため core だけを先読みする。
      ただしページ全体のLCP例外はフォントではなくHTML文書量が原因なので、
      ext まで先読みしても改善しない。
    */
    '/fonts/ZenKakuGothicNew-Regular.woff2',
  ]}
>
  <article class="about">
    <header class="about__header card">
      <h1 class="about__title font-display">ABOUT THIS SITE</h1>
      {/* ファーストビューの和文。ext の到着を待たせないため core に含める（scripts/subset-fonts.mjs）*/}
      <p class="about__lead" data-font-core>
        派手な演出を持ちながら速度を落とさないこと自体が、このサイトの主張です。
        実装は変わり続けるため、現在の構成と変えた理由を、数値と一緒に公開します。
      </p>
    </header>

    <section class="about__section card" aria-labelledby="metrics-heading">
      <h2 id="metrics-heading" class="about__heading">実測値</h2>
      <p class="about__measured font-mono">
        最終計測: {measuredAt} / {metrics.environment}
      </p>

      <ul class="scores">
        {
          budgets.map((b) => (
            <li class="score">
              <span class="score__value font-display">{b.value}</span>
              <span class="score__label font-mono">{b.label}</span>
              <span class="score__target font-mono">目標 {b.target}</span>
            </li>
          ))
        }
      </ul>

      <table class="vitals">
        <caption class="vitals__caption font-mono">パフォーマンス予算の実測</caption>
        <thead>
          <tr>
            <th scope="col">指標</th>
            <th scope="col">実測</th>
            <th scope="col">目標</th>
          </tr>
        </thead>
        <tbody>
          {
            vitals.map((v) => (
              <tr>
                <th scope="row" class="font-mono">
                  {v.label}
                </th>
                <td class="font-mono vitals__value">
                  {v.value}
                  {v.unit}
                </td>
                <td class="font-mono vitals__target">{v.target}</td>
              </tr>
            ))
          }
        </tbody>
      </table>

      <p class="about__note">
        数値は手打ちではありません。PRごとに Lighthouse で検証し、
        main が更新されたときに測り直して
        <code class="font-mono">src/data/metrics.json</code> へ保存した値です。
        予算を割った変更はマージできません。
      </p>

      {/* 守れていない箇所は理由と一緒に書く */}
      <p class="about__note">
        <strong>このページだけ LCP の目標を 2.4s にしています。</strong>
        律速は HTML の量そのもので、文章を足すとそのぶん遅くなります。
        内容を削るより数値を公開する方を選びました。他のページは 2.0s のままです。
      </p>
    </section>

    <section class="about__section card" aria-labelledby="stack-heading">
      <h2 id="stack-heading" class="about__heading">技術スタック</h2>
      <p class="about__body">
        何を使ったかは <code class="font-mono">package.json</code> を見れば分かります。
        ここに書くのは、なぜそれを選んだかです。
      </p>

      {
        stack.map((group) => (
          <div class="stack">
            <h3 class="stack__category font-mono">{group.category}</h3>
            <dl class="stack__list">
              {group.items.map((item) => (
                <div class="stack__item">
                  <dt class="stack__name font-mono">{item.name}</dt>
                  <dd class="stack__note">{item.note}</dd>
                </div>
              ))}
            </dl>
          </div>
        ))
      }
    </section>

    <section class="about__section card" aria-labelledby="craft-heading">
      <h2 id="craft-heading" class="about__heading">こだわりと工夫</h2>
      <p class="about__body">
        実際に踏んだ問題と、その対処です。<strong>このサイトで測って決めたこと</strong>だけを載せています。
      </p>

      <ol class="craft">
        {
          craft.map((c, i) => (
            <li class="craft__item">
              <p class="craft__index font-mono">{String(i + 1).padStart(2, '0')}</p>
              <div>
                <h3 class="craft__title">{c.title}</h3>
                <p class="craft__body">{c.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    {/* ログは長いので、節の導入で1枚、エントリ1件で1枚のカードにする */}
    <section class="about__section about__section--log" aria-labelledby="log-heading">
      <div class="card">
        <h2 id="log-heading" class="about__heading">意思決定ログ</h2>
        <p class="about__body">
          採用した技術より、採用しなかった選択肢のほうが設計を語ります。
          各エントリには必ず「検討したが選ばなかったもの」を含めています。
        </p>
      </div>

      <ol class="log">
        {
          renderedNotes.map(({ note, Content }) => (
            <li class="log__entry card">
              <article>
                <p class="log__date font-mono">
                  <time datetime={note.data.date.toISOString()}>
                    {note.data.date.toLocaleDateString('ja-JP', {
                      year: 'numeric',
                      month: '2-digit',
                      day: '2-digit',
                    })}
                  </time>
                </p>
                <h3 class="log__title">{note.data.title}</h3>

                <dl class="log__meta">
                  <dt class="font-mono">判断したこと</dt>
                  <dd>{note.data.decision}</dd>

                  <dt class="font-mono">検討した選択肢</dt>
                  <dd>
                    <ul class="log__alts">
                      {note.data.alternatives.map((alt) => (
                        <li>
                          <span class="log__alt-option">{alt.option}</span>
                          <span class="log__alt-why">{alt.why_not}</span>
                        </li>
                      ))}
                    </ul>
                  </dd>

                  <dt class="font-mono">決め手</dt>
                  <dd>{note.data.verdict}</dd>
                </dl>

                <div class="log__body">
                  <Content />
                </div>
              </article>
            </li>
          ))
        }
      </ol>
    </section>
  </article>
</Base>

<script>
  // 意思決定ログは縦に長いため、エントリ単位で控えめにリビールする。
  // 署名要素（成果物のネオン看板）より目立たせないこと（§10）。
  //
  // ClientRouter では、この <script> は最初に出会ったときに一度しか評価されない。
  // そのため astro:page-load で今のページのログに仕掛け、astro:before-swap で外す
  // （WorksList.astro と同じ形）。リスナーは評価時に一度だけ登録されるので、遷移のたびに増えない。
  import { initReveal } from '../components/motion/reveal';

  // いまリビールを仕掛けているログと、その後始末
  let active: { log: HTMLElement; cleanup: () => void } | null = null;

  function unmount() {
    active?.cleanup();
    active = null;
  }

  function mount() {
    const log = document.querySelector<HTMLElement>('.log');
    // 同じログにはもう仕掛けてある（評価時と astro:page-load の両方から呼ばれるため）
    if (active && active.log === log) return;
    unmount();
    if (log) active = { log, cleanup: initReveal('.log__entry', log) };
  }

  document.addEventListener('astro:page-load', mount);
  document.addEventListener('astro:before-swap', unmount);

  // 遷移で初めてこのページに来たとき、評価が astro:page-load の後になることがあるので、
  // 評価時にも一度呼ぶ（すでに仕掛けてあれば何もしない）。
  mount();
</script>

<style>
  @layer components {
    /*
      ページ全体を1枚の面で覆わない。導入・各節・意思決定ログの各件をそれぞれ
      カード（.card）にし、カードのあいだに夜景を見せる。一段落ごとにはカードにしない。
      中身の読み幅はカードを入れる前（72ch から左右 space-3 を引いた幅）に保ち、
      カードの内側の余白はその外に足す。上はヘッダーの帯（夜景）をあけて始める。
    */
    .about {
      width: min(
        72ch - var(--space-3) * 2 + var(--card-pad) * 2,
        100% - var(--card-gutter) * 2
      );
      margin: calc(var(--space-5) + var(--space-3)) auto var(--space-6);
    }

    .about__header {
      margin-bottom: var(--space-5);
    }

    .about__title {
      font-size: var(--fs-h1);
      color: var(--c-fluorescent);
      margin-bottom: var(--space-3);
    }

    .about__lead {
      color: var(--c-text);
    }

    .about__section {
      margin-bottom: var(--space-5);
    }

    .about__heading {
      font-size: var(--fs-h2);
      color: var(--c-fluorescent);
      margin-bottom: var(--space-2);
      padding-bottom: var(--space-1);
      border-bottom: 1px solid var(--c-facade-lit);
    }

    /*
      注記（.about__note）も文章として読ませるので、本文と同じ色と大きさにする。
      小さく暗いのは計測日時のような補助情報（.about__measured）だけ。
    */
    .about__body,
    .about__note {
      color: var(--c-text);
      margin-block: var(--space-2);
    }

    .about__measured {
      color: var(--c-dust);
      font-size: var(--fs-small);
      margin-block: var(--space-2);
    }

    code {
      color: var(--c-fluorescent);
      font-size: 0.9em;
    }

    /* --- 技術スタック --- */
    .stack {
      margin-top: var(--space-4);
    }

    .stack__category {
      color: var(--c-dust);
      font-size: var(--fs-caption);
      letter-spacing: 0.16em;
      font-weight: 400;
      padding-bottom: var(--space-1);
      border-bottom: 1px solid var(--c-facade);
    }

    .stack__list {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      margin-top: var(--space-3);
    }

    .stack__name {
      color: var(--c-fluorescent);
      font-size: var(--fs-small);
      display: flex;
      align-items: center;
      gap: 0.6em;
    }

    /* 項目の頭に灯を1つ。窓明かりの見立てを小さく反復させる */
    .stack__name::before {
      content: '';
      width: 5px;
      height: 7px;
      flex: none;
      border-radius: 1px;
      background: var(--c-facade-lit);
      box-shadow: 0 0 8px -2px var(--c-signal);
    }

    /* 名前（ラベル）は小さく、なぜ選んだか（文章）は本文の大きさで読ませる */
    .stack__note {
      margin: var(--space-1) 0 0 calc(5px + 0.6em);
      color: var(--c-text);
      font-size: var(--fs-body);
      line-height: 1.85;
    }

    /* --- こだわりと工夫 --- */
    .craft {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      margin-top: var(--space-4);
      counter-reset: craft;
    }

    .craft__item {
      display: grid;
      grid-template-columns: 2.5rem 1fr;
      gap: var(--space-2);
      align-items: start;
    }

    /*
      連番。窓の並びに見えるよう光らせるが、芯は白に寄せる（§6.4）。
      --c-signal をそのまま文字色にすると黒地で 2.57:1 しか出ず、
      §1.3 の 4.5:1 を割る（実測）。色は glow 側に持たせる。
    */
    .craft__index {
      color: var(--neon-violet-core);
      font-size: var(--fs-small);
      text-shadow:
        0 0 6px var(--c-signal),
        0 0 16px color-mix(in srgb, var(--c-signal) 60%, transparent);
      padding-top: 0.15em;
    }

    .craft__title {
      font-size: var(--fs-body);
      color: var(--c-fluorescent);
      line-height: 1.6;
    }

    .craft__body {
      margin-top: var(--space-1);
      color: var(--c-text);
      font-size: var(--fs-body);
      line-height: 1.9;
    }

    strong {
      color: var(--c-fluorescent);
      font-weight: 700;
    }

    @media (max-width: 640px) {
      .craft__item {
        grid-template-columns: 1.75rem 1fr;
        gap: var(--space-1);
      }
    }

    /* --- スコア --- */
    .scores {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(7rem, 1fr));
      gap: var(--space-2);
      margin-block: var(--space-3);
    }

    .score {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
      padding: var(--space-2);
      background: var(--c-facade);
      border-radius: var(--radius-panel);
    }

    .score__value {
      font-size: var(--fs-h1);
      color: var(--c-fluorescent);
      line-height: 1;
    }

    .score__label {
      color: var(--c-fluorescent);
      font-size: var(--fs-caption);
    }

    .score__target {
      color: var(--c-dust);
      font-size: var(--fs-caption);
    }

    /* --- 予算テーブル --- */
    .vitals {
      width: 100%;
      border-collapse: collapse;
      margin-block: var(--space-3);
      font-size: var(--fs-small);
    }

    .vitals__caption {
      text-align: left;
      color: var(--c-dust);
      font-size: var(--fs-caption);
      padding-bottom: var(--space-1);
    }

    .vitals th,
    .vitals td {
      text-align: left;
      padding: var(--space-1) var(--space-2);
      border-bottom: 1px solid var(--c-facade);
    }

    .vitals thead th {
      color: var(--c-dust);
      font-size: var(--fs-caption);
      font-weight: 400;
      letter-spacing: 0.06em;
    }

    .vitals tbody th {
      color: var(--c-dust);
      font-weight: 400;
    }

    .vitals__value {
      color: var(--c-fluorescent);
    }

    .vitals__target {
      color: var(--c-dust);
    }

    /* --- 意思決定ログ --- */
    .log {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      margin-top: var(--space-4);
    }

    .log__date {
      color: var(--c-dust);
      font-size: var(--fs-caption);
    }

    .log__title {
      font-size: var(--fs-h2);
      color: var(--c-fluorescent);
      margin-block: var(--space-1) var(--space-2);
    }

    .log__meta {
      display: grid;
      gap: var(--space-1);
      padding: var(--space-3);
      background: var(--c-facade);
      border-radius: var(--radius-panel);
    }

    .log__meta dt {
      color: var(--c-dust);
