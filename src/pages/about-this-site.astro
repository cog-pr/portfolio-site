---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import IgniteDemo from '../components/facade/IgniteDemo.astro';
import metrics from '../data/metrics.json';

// 意思決定ログは時系列（古い順）。判断がどう積み上がったかを読ませるため。
const notes = (await getCollection('notes')).sort(
  (a, b) => a.data.date.valueOf() - b.data.date.valueOf()
);
const renderedNotes = await Promise.all(
  notes.map(async (note) => ({ note, Content: (await render(note)).Content }))
);

const budgets = [
  { label: 'Performance', value: metrics.scores.performance, target: '95 以上', unit: '' },
  { label: 'Accessibility', value: metrics.scores.accessibility, target: '100', unit: '' },
  { label: 'Best Practices', value: metrics.scores.bestPractices, target: '100（警告）', unit: '' },
  { label: 'SEO', value: metrics.scores.seo, target: '100（警告）', unit: '' },
];

const vitals = [
  {
    label: 'LCP',
    value: (metrics.vitals.lcpMs / 1000).toFixed(2),
    unit: 's',
    target: '2.0s 以下',
  },
  { label: 'CLS', value: metrics.vitals.cls.toFixed(3), unit: '', target: '0.05 以下' },
  { label: 'TBT', value: String(metrics.vitals.tbtMs), unit: 'ms', target: '200ms 以下' },
  {
    label: '初期JS (gzip)',
    value: (metrics.budget.initialJsGzipBytes / 1024).toFixed(1),
    unit: 'KB',
    target: '30KB 以下（設計）',
  },
  {
    label: 'フォント合計',
    value: (metrics.budget.fontsBytes / 1024).toFixed(1),
    unit: 'KB',
    target: '200KB 以下',
  },
];

/*
  技術スタック。採用理由まで書く。
  「何を使ったか」だけならpackage.jsonを見れば分かるので、
  このページの価値は「なぜそれを選んだか」にある。
*/
const stack = [
  {
    category: 'フレームワーク',
    items: [
      {
        name: 'Astro',
        note: '静的HTMLを先に出し、必要な演出だけをクライアント側へ載せる。作品と意思決定ログは Markdown の Content Collections として管理し、ビルド時に検証している。',
      },
      {
        name: 'TypeScript (strict)',
        note: '演出の中身まで型を通す。React / Vue などのUIランタイムは加えず、Astro コンポーネントと素の TypeScript で実装している。',
      },
    ],
  },
  {
    category: '見た目',
    items: [
      {
        name: '素のCSS + カスケードレイヤー',
        note: 'Tailwind は使わない。デザイントークンを一次情報として持ちたかったのと、ユーティリティクラスの羅列ではこのページで説明しづらいため。',
      },
      {
        name: 'Archivo / Zen Kaku Gothic New / IBM Plex Mono',
        note: '全てセルフホスト。Google Fonts への実行時接続はしない（third-party接続はLCPを悪化させる）。',
      },
    ],
  },
  {
    category: '演出',
    items: [
      {
        name: 'GSAP + ScrollTrigger',
        note: '看板の点灯シーケンスと縦看板のパララックスに限定して使う。最初の操作か2.5秒経過まで取得を待ち、reduced-motion では取得しない。',
      },
      {
        name: 'OGL',
        note: '背景シェーダー1枚に必要な処理だけを扱える薄い WebGL ラッパー。GPUを使えない環境では初期化せず、CSSの背景を残す。',
      },
    ],
  },
  {
    category: '配信',
    items: [
      {
        name: 'Cloudflare Workers (Static Assets)',
        note: 'Worker スクリプトを持たないアセットのみの構成。公開URLは mawo.dev に一本化し、PR用のプレビューURLだけを残している。',
      },
      {
        name: 'GitHub Actions + Lighthouse CI',
        note: 'PRでは4ページを計測して予算を検証する。main 更新後はトップを再計測し、このページが読む実測値とフォントのサブセットを自動更新する。',
      },
    ],
  },
];

/*
  こだわり・工夫。
  実装中に実際に踏んだ問題と、その対処を書く。
  一般論ではなく、このサイトで測って決めたことだけを載せる。
*/
const craft = [
  {
    title: '和文フォントを出力HTMLから逆算して切る',
    body: 'サブセット対象の文字を、ソースコードではなくビルド後のHTMLから集めている。ソースを走査すると日本語のコード内コメントまで拾い、描画されない文字のためにフォントが太る。Bold も本文全体ではなく、見出し・strong・表見出しに実際に出る文字だけから毎回作り直す。',
  },
  {
    title: '和文をトップ用と残りに分割する',
    body: 'サイト全体の和文を1ファイルにすると、入口ページが「このサイトについて」の長文で使う文字まで読み込む。unicode-range で core / ext に分け、トップと成果物一覧は core だけで完結させた。このページの導入文だけは明示的に core へ加える。境界を広げると入口のLCPが悪化するため、実測で範囲を決めている。',
  },
  {
    title: '欧文は1ウェイトに固定する',
    body: '可変フォントは便利だが、LCP要素の書体では話が別だった。wght 400-700 の可変で20.1KB、ウェイト別2ファイルではリクエストが1本増える。どちらもLCPを1.86s→2.10sまで悪化させたので、wdth 80 / wght 700 の単一インスタンス（9.3KB）に固定した。',
  },
  {
    title: 'preload はページのLCP要素に絞る',
    body: '書体を全部 preload すると帯域を奪い合って逆効果になる。共通では欧文見出し用の Archivo だけを先読みし、和文の導入文がLCPになるこのページだけ Zen Kaku Gothic New Regular を加えている。IBM Plex Mono は先読みしない。',
  },
  {
    title: 'アイランドの起動スクリプトを1本にまとめる',
    body: 'コンポーネントごとに script を置くと、小さなチャンクが別々のリクエストになる。成果物一覧では看板の点灯・光害の空・縦看板を1本の入口から起動し、GSAP と OGL は必要になった時点で動的 import する。さらに最初の操作か2.5秒経過まで観測自体を待ち、本文とフォントを先に配る。',
  },
  {
    title: 'GPUが無い環境では背景シェーダーを動かさない',
    body: 'GPUを持たない環境ではWebGLがソフトウェア描画になり、全画面のfBmシェーダーを毎フレームCPUで解くことになる。実際CIで Performance 0.71 / TBT 2180ms まで落ちた。内訳を見るとスクリプト実行は290msで、残りはラスタライズだった。描画元を検出して初期化を諦め、CSSのグラデーションに任せている。',
  },
  {
    title: '計測は本番と同じ圧縮条件で行う',
    body: 'astro preview は無圧縮で配信するため、そのまま測ると本番より悪い数値が出る。Workers Static Assets の圧縮あり配信に合わせ、計測用に gzip を返す静的サーバーを用意した。ローカルとCIで同じ条件を使う。',
  },
  {
    title: '窓グリッドをやめて看板にした',
    body: '当初は3:4の窓を敷き詰め、65〜75%を装飾の消灯セルで埋めていた。作品名とサムネイルはホバー時のみ表示する設計だった。これが機能しておらず、静止状態では暗い四角が並ぶだけでどれが作品か分からない上、タッチ端末にはホバーが無いためタップするまで内容が不明だった。装飾セルは「空枠」に見えるだけで装飾として働いていなかった。比喩より機能を優先し、1作品=1枚の看板として名前と姿を常時見せる形に変えた。夜の街で実際に目に入るのは窓ではなく看板で、看板はそもそも読ませるために光っている。',
  },
  {
    title: 'ネオンの芯は白に寄せる',
    body: '実物のネオン管は中心が白飛びしていて、色は周囲に出る。中心まで管の色のままだと「文字に影を付けただけ」に見える。芯・内側グロー・外側グロー・壁への漏れ光の4層で組んでいる。',
  },
  {
    title: '光の上でもコントラストを実測する',
    body: 'グローは背景を明るくするので、文字色との比が下がる。写真背景を入れたとき、ヘッダーのナビが青いネオンの上に来て 3.30:1 まで落ちていた（基準は4.5:1）。文字を消した状態でスクリーンショットを撮り、文字が乗る領域の最も明るい画素と比較して確認している。',
  },
];

/*
  検索エンジンからの見え方。
  スタック一覧と同じ構造にして、同じマークアップで描画する。

  ここは「打った手」であって「結果」ではない。
  実測値セクションと混ぜないこと（区別が読者に伝わらなくなる）。

  なお、このページは文字を足すとそのまま LCP が伸びる（下記の但し書き）。
  各項目は一文で書き、理由は意思決定ログ側に置くこと。
*/
const seo = [
  {
    category: 'サイトに実装したもの',
    items: [
      {
        name: '構造化データ (JSON-LD)',
        note: 'Person と WebSite を書き、sameAs で GitHub と X に紐付けた。書くのは名前・URL・アカウント・連絡先だけで、肩書きのような主観は入れない。',
      },
      {
        name: 'sitemap-index.xml / robots.txt',
        note: 'ビルド時に全ページのURLを列挙し、robots.txt からその場所を指している。',
      },
      {
        name: 'canonical / OGP',
        note: '正規URLを明示し、SNSに貼られたときのカード表示も絶対URLで指定している。',
      },
      {
        name: 'JSなしで読める静的HTML',
        note: 'クローラーにはこれが最も確実な条件で、しかもSEOのために用意したものではない。演出を遅延ロードへ追い出した設計がそのまま効いている。',
      },
      {
        name: '公開URLは mawo.dev のみ',
        note: '自動割り当ての workers.dev URL は閉じ、同じ内容を別URLで配らない。マージ前に確認するためのPRプレビューだけは残している。',
      },
    ],
  },
  {
    category: 'サイトの外で設定したもの',
    items: [
      {
        name: 'Search Console',
        note: 'DNSのTXTレコードで所有権を確認し、サイトマップを送信した。',
      },
      {
        name: 'GitHub リポジトリの改名',
        note: 'ドメインと同名だったリポジトリの名前を変えた。理由は下の意思決定ログにある。',
      },
    ],
  },
];

const measuredAt = new Date(metrics.measuredAt).toLocaleString('ja-JP', {
  timeZone: 'Asia/Tokyo',
  dateStyle: 'medium',
  timeStyle: 'short',
});
---

<Base
  title="About This Site"
  description="Mawo's Portfolio の現行構成、実測値、仕様変更を含む意思決定の記録。"
  preloadFonts={[
    /*
      このページのLCP要素は導入文（和文）。data-font-core で core 側に寄せ、
      ext の到着を待たせないため core だけを先読みする。
      ただしページ全体のLCP例外はフォントではなくHTML文書量が原因なので、
      ext まで先読みしても改善しない。
    */
    '/fonts/ZenKakuGothicNew-Regular.woff2',
  ]}
>
  <article class="about">
    <header class="about__header">
      <h1 class="about__title font-display">ABOUT THIS SITE</h1>
      {/* ファーストビューの和文。ext の到着を待たせないため core に含める（scripts/subset-fonts.mjs）*/}
      <p class="about__lead" data-font-core>
        派手な演出を持ちながら速度を落とさないこと自体が、このサイトの主張です。
        実装は変わり続けるため、現在の構成と変えた理由を、数値と一緒に公開します。
      </p>
    </header>

    <section class="about__section" aria-labelledby="metrics-heading">
      <h2 id="metrics-heading" class="about__heading">実測値</h2>
      <p class="about__note font-mono">
        最終計測: {measuredAt} / {metrics.environment}
      </p>

      <ul class="scores">
        {
          budgets.map((b) => (
            <li class="score">
              <span class="score__value font-display">{b.value}</span>
              <span class="score__label font-mono">{b.label}</span>
              <span class="score__target font-mono">目標 {b.target}</span>
            </li>
          ))
        }
      </ul>

      <table class="vitals">
        <caption class="vitals__caption font-mono">パフォーマンス予算の実測</caption>
        <thead>
          <tr>
            <th scope="col">指標</th>
            <th scope="col">実測</th>
            <th scope="col">目標</th>
          </tr>
        </thead>
        <tbody>
          {
            vitals.map((v) => (
              <tr>
                <th scope="row" class="font-mono">
                  {v.label}
                </th>
                <td class="font-mono vitals__value">
                  {v.value}
                  {v.unit}
                </td>
                <td class="font-mono vitals__target">{v.target}</td>
              </tr>
            ))
          }
        </tbody>
      </table>

      <p class="about__note">
        これらの数値は手打ちではありません。PRでは Lighthouse で予算を検証し、
        main が更新されたときにトップページを再計測して
        <code class="font-mono">src/data/metrics.json</code>
        へ保存します。このページが表示するのは、その最新値です。
        Performance・Accessibility・LCP・CLS・TBT・転送量はマージを止める基準、
        Best Practices と SEO は警告として扱います。
      </p>

      {/*
        自分の例外を隠して数値だけ出すのは、このページの趣旨に反する。
        守れていない箇所は理由と一緒に書く。
      */}
      <p class="about__note">
        <strong>このページだけ LCP の目標を 2.4s に緩めています。</strong>
        当初これを「和文フォントの到着待ち」と説明していましたが、<strong>誤りでした</strong>。
        FCP が 1.9s あり、LCP との差は 0.2s しかありません。効いているのは
        <strong>HTML 文書そのものの大きさ</strong>で、文章を足すとそのぶん素直に遅くなります。
        preload もサブセットの切り分けも、文書量のボトルネックには効きませんでした。
        内容を削れば通りますが、それはこのページの存在価値を削ることになるので、
        数値のほうを譲りました。CI ではこのページだけ 2.4s、他は 2.0s のまま判定しています。
      </p>
    </section>

    <section class="about__section" aria-labelledby="stack-heading">
      <h2 id="stack-heading" class="about__heading">技術スタック</h2>
      <p class="about__body">
        何を使ったかは <code class="font-mono">package.json</code> を見れば分かります。
        ここに書くのは、なぜそれを選んだかです。
      </p>

      {
        stack.map((group) => (
          <div class="stack">
            <h3 class="stack__category font-mono">{group.category}</h3>
            <dl class="stack__list">
              {group.items.map((item) => (
                <div class="stack__item">
                  <dt class="stack__name font-mono">{item.name}</dt>
                  <dd class="stack__note">{item.note}</dd>
                </div>
              ))}
            </dl>
          </div>
        ))
      }
    </section>

    <section class="about__section" aria-labelledby="craft-heading">
      <h2 id="craft-heading" class="about__heading">こだわりと工夫</h2>
      <p class="about__body">
        現在の実装へ至るまでに実際に踏んだ問題と、その対処です。一般論ではなく、
        <strong>このサイトで測って決めたこと</strong>だけを載せています。
      </p>

      <ol class="craft">
        {
          craft.map((c, i) => (
            <li class="craft__item">
              <p class="craft__index font-mono">{String(i + 1).padStart(2, '0')}</p>
              <div>
                <h3 class="craft__title">{c.title}</h3>
                <p class="craft__body">{c.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="about__section" aria-labelledby="seo-heading">
      <h2 id="seo-heading" class="about__heading">検索結果での見え方</h2>
      <p class="about__body">
        公開当初、このドメイン名は GitHub のリポジトリ名と同じでした。検索すると、
        サイトより先にソースコードのリポジトリが出てきます。検索エンジンから見えるのは
        <strong>同じ文字列を持つ2つのページ</strong>でしかなく、どちらが本人の公式サイトかを
        判断する材料がありませんでした。順位ではなく、識別の問題です。
      </p>

      {
        seo.map((group) => (
          <div class="stack">
            <h3 class="stack__category font-mono">{group.category}</h3>
            <dl class="stack__list">
              {group.items.map((item) => (
                <div class="stack__item">
                  <dt class="stack__name font-mono">{item.name}</dt>
                  <dd class="stack__note">{item.note}</dd>
                </div>
              ))}
            </dl>
          </div>
        ))
      }

      {/*
        このページは実測値を出すことで成り立っている。
        測っていないものを同じ調子で並べると、その信頼を借りることになる。
      */}
      <p class="about__note">
        <strong>ここだけは実測値がありません。</strong>
        順位は自分で決められる指標ではなく、反映までの時間も制御できません。
        この節に書いたのは<strong>打った手であって、結果ではありません</strong>。
        読めるようになった時点で数値を出します。外していたらそう書きます。
      </p>
    </section>

    <section class="about__section" aria-labelledby="demo-heading">
      <h2 id="demo-heading" class="about__heading">演出の Before / After</h2>
      <p class="about__body">
        成果物一覧の看板が順に強く点灯し、微光へ落ち着くシーケンスを、その場で操作できます。
        <code class="font-mono">stagger</code>（看板間の遅延）と
        <code class="font-mono">duration</code>（1看板が点灯して落ち着くまでの合計尺）を変えると、
        同じ演出がどれだけ印象を変えるかが分かります。
      </p>
      <IgniteDemo />
    </section>

    <section class="about__section" aria-labelledby="log-heading">
      <h2 id="log-heading" class="about__heading">意思決定ログ</h2>
      <p class="about__body">
        採用した技術より、採用しなかった選択肢のほうが設計を語ります。
        各エントリには必ず「検討したが選ばなかったもの」を含めています。
      </p>

      <ol class="log">
        {
          renderedNotes.map(({ note, Content }) => (
            <li class="log__entry">
              <article>
                <p class="log__date font-mono">
                  <time datetime={note.data.date.toISOString()}>
                    {note.data.date.toLocaleDateString('ja-JP', {
                      year: 'numeric',
                      month: '2-digit',
                      day: '2-digit',
                    })}
                  </time>
                </p>
                <h3 class="log__title">{note.data.title}</h3>

                <dl class="log__meta">
                  <dt class="font-mono">判断したこと</dt>
                  <dd>{note.data.decision}</dd>

                  <dt class="font-mono">検討した選択肢</dt>
                  <dd>
                    <ul class="log__alts">
                      {note.data.alternatives.map((alt) => (
                        <li>
                          <span class="log__alt-option">{alt.option}</span>
                          <span class="log__alt-why">{alt.why_not}</span>
                        </li>
                      ))}
                    </ul>
                  </dd>

                  <dt class="font-mono">決め手</dt>
                  <dd>{note.data.verdict}</dd>
                </dl>

                <div class="log__body">
                  <Content />
                </div>
              </article>
            </li>
          ))
        }
      </ol>
    </section>
  </article>
</Base>

<script>
  // 意思決定ログは縦に長いため、エントリ単位で控えめにリビールする。
  // 署名要素（成果物のネオン看板）より目立たせないこと（§10）。
  import { initReveal } from '../components/motion/reveal';
  initReveal('.log__entry');
</script>

<style>
  @layer components {
    .about {
      max-width: 72ch;
      margin-inline: auto;
      padding: var(--space-5) var(--space-3) var(--space-6);
    }

    .about__header {
      margin-bottom: var(--space-6);
    }

    .about__title {
      font-size: var(--fs-h1);
      color: var(--c-fluorescent);
      margin-bottom: var(--space-3);
    }

    .about__lead {
      color: var(--c-dust);
    }

    .about__section {
      margin-bottom: var(--space-6);
    }

    .about__heading {
      font-size: var(--fs-h2);
      color: var(--c-fluorescent);
      margin-bottom: var(--space-2);
      padding-bottom: var(--space-1);
      border-bottom: 1px solid var(--c-facade-lit);
    }

    .about__body,
    .about__note {
      color: var(--c-dust);
      margin-block: var(--space-2);
    }

    .about__note {
      font-size: var(--fs-small);
    }

    code {
      color: var(--c-fluorescent);
      font-size: 0.9em;
    }

