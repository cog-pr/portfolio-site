---
import Base from '../layouts/Base.astro';
import Profile from '../components/profile/Profile.astro';
import Timeline from '../components/profile/Timeline.astro';
import WorksEntry from '../components/facade/WorksEntry.astro';
import { SITE_NAME } from '../lib/site';

/*
  トップページ（仕様書 §5.1）。

  成果物の一覧は `/works/` に分けた。ここが担うのは
  「誰のサイトか」と「どこに何があるか」の2つだけ。

  ヒーローは夜景（SiteBackdrop）を直接見せる領域。その下は、同じ夜景の上に
  プロフィール・経歴の各件・入口がそれぞれカードとして載る領域になる。
*/
---

{/* トップのページ名はサイト名そのもの。タブでは繰り返さない（Base.astro） */}
<Base
  title={SITE_NAME}
  description="中野広翔（まを / mawo）のポートフォリオ。設計から実装まで手を入れた成果物と、その過程での判断をまとめています。"
  siteJsonLd
  heroBackdrop
>
  {/*
    写真はサイト共通の背景（SiteBackdrop）を使う。ヒーローは自前の画像を持たず、
    その背景を直接見せる。同じ写真を2枚重ねない・2回取得しないため。
  */}
  <section class="hero">
    <h1 class="hero__title font-display">
      <span class="hero__line" style="--i: 0">Mawo's</span>
      <span class="hero__line" style="--i: 1">Portfolio</span>
    </h1>
    <p class="hero__role font-mono" style="--i: 2">Developer / ML Engineer</p>
    <a href="#profile" class="hero__scroll" aria-label="SCROLL — プロフィールへ">
      <span class="hero__scroll-track" aria-hidden="true"></span>
      <span class="font-mono hero__scroll-label">SCROLL</span>
    </a>
  </section>
  {/*
    ここから下は、同じ夜景を背景に残したまま、情報のまとまりごとのカードで読む。
    セクション自体は地を持たず、カードとカードのあいだから夜景が見える。
  */}
  <Profile />
  <Timeline />
  <WorksEntry />
</Base>

<style>
  @layer components {
    .hero {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      justify-content: center;
      gap: var(--space-2);
      min-height: 100svh;
      padding: var(--space-3);
      overflow: hidden;
    }

    /*
      文字が乗る左側を重点的に暗くするスクリム。
      文字のコントラスト 4.5:1 以上（§1.3）を写真の上でも確保するため。
      写真そのものと画面下端の暗がりは SiteBackdrop が持つ。

      ヒーローと一緒に流れるので、下端はマスクで溶かす。切り落とすと
      ヒーローの終わりで左端の夜景に暗い段が付き、下の領域と別の写真に見える。
    */
    .hero::before {
      content: '';
      position: absolute;
      inset: 0;
      pointer-events: none;
      background: linear-gradient(
        to right,
        color-mix(in srgb, var(--c-void) 92%, transparent) 0%,
        color-mix(in srgb, var(--c-void) 62%, transparent) 38%,
        transparent 72%
      );
      mask-image: linear-gradient(to bottom, #000 65%, transparent);
    }

    /* 文字と誘導は画像より前面へ */
    .hero__title,
    .hero__role,
    .hero__scroll {
      position: relative;
      z-index: 1;
    }

    .hero__title {
      font-size: var(--fs-display);
      line-height: var(--lh-display);
      color: var(--c-fluorescent);
      display: flex;
      flex-direction: column;
    }

    .hero__line {
      display: block;
      /* JSに依存せず、静的HTML＋CSSのみで最初からフェードインする（ヒーローはLCP要素） */
      animation: line-in var(--dur-slow) var(--ease-out) both;
      animation-delay: calc(var(--i) * 120ms);
    }

    .hero__role {
      color: var(--c-dust);
      font-size: var(--fs-small);
      letter-spacing: 0.08em;
      animation: line-in var(--dur-slow) var(--ease-out) both;
      animation-delay: calc(var(--i) * 120ms);
    }

    .hero__scroll {
      position: absolute;
      bottom: var(--space-4);
      left: var(--space-3);
      display: flex;
      align-items: center;
      gap: var(--space-1);
      color: var(--c-dust);
    }

    .hero__scroll-label {
      font-size: var(--fs-caption);
      letter-spacing: 0.1em;
    }

    .hero__scroll-track {
      width: 1px;
      height: 1.5rem;
      background: var(--c-dust);
      animation: scroll-hint var(--dur-slow) var(--ease-inout) infinite;
    }

    @keyframes line-in {
      from {
        opacity: 0;
        transform: translateY(0.6em);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes scroll-hint {
      0%,
      100% {
        transform: translateY(0);
      }
      50% {
        transform: translateY(4px);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .hero__line,
      .hero__role,
      .hero__scroll-track {
        animation: none;
        opacity: 1;
        transform: none;
      }
    }
  }
</style>
