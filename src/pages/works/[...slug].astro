---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const works = await getCollection('works', ({ data }) => !data.draft);
  return works.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { title, titleEn, year, roles, stack, summary, cover, links } = entry.data;
const { Content } = await render(entry);
---

<Base title={titleEn ?? title} description={summary}>
  <article class="work">
    <header class="work__header">
      <Image
        src={cover}
        alt={`${title} のカバー画像`}
        width={1600}
        height={900}
        loading="eager"
        fetchpriority="high"
        class="work__cover"
        transition:name={`work-${entry.id}`}
      />
      <h1 class="work__title font-display">{titleEn ?? title}</h1>
      {titleEn && <p class="work__title-jp">{title}</p>}
    </header>

    <div class="work__body">
      <aside class="work__meta font-mono" aria-label="制作情報">
        <dl>
          <div>
            <dt>YEAR</dt>
            <dd>{year}</dd>
          </div>
          <div>
            <dt>ROLE</dt>
            <dd>{roles.join(' / ')}</dd>
          </div>
          <div>
            <dt>STACK</dt>
            <dd>{stack.join(' / ')}</dd>
          </div>
        </dl>

        {/*
          外部リンク。作品ページに来た人が次に押すのはここなので、
          メタ情報の最後に置く。別タブで開く（フッターのSNSリンクと同じ扱い）。
          サイト外へ出す導線なので、戻ってこられるようにしておく。
        */}
        {
          links.length > 0 && (
            <ul class="work__links">
              {links.map((link) => (
                <li>
                  <a href={link.href} rel="noopener noreferrer" target="_blank">
                    {link.label} <span aria-hidden="true">&#8599;</span>
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </aside>

      <div class="work__content">
        <Content />
      </div>
    </div>

    <a href="/works/" class="work__back font-mono">&larr; 成果物一覧へ戻る</a>
  </article>
</Base>

<style>
  @layer components {
    .work {
      max-width: 72ch;
      margin-inline: auto;
      padding: var(--space-5) var(--space-3);
    }

    .work__header {
      margin-bottom: var(--space-5);
    }

    .work__cover {
      width: 100%;
      height: auto;
      aspect-ratio: 16 / 9;
      object-fit: cover;
      border-radius: var(--radius-panel);
      margin-bottom: var(--space-3);
    }

    .work__title {
      font-size: var(--fs-h1);
      color: var(--c-fluorescent);
      /*
        h1 はブラウザ既定で太字になる。作品名が和文だと weight 700 の
        和文フェイス（ZenKakuGothicNew-Bold / 36KB）を要求してしまい、
        実測で CI の LCP が 1953→2104ms、予算 2000ms を割った。

        400 にしても欧文の見た目は変わらない。Archivo は @font-face を
        font-weight: 400 700 で宣言した wght 700 の静的インスタンス1本なので、
        400 を要求しても同じファイルが使われる。
        一覧の看板（.sign__title / span）も 400 なので、そちらとも揃う。
      */
      font-weight: 400;
    }

    .work__title-jp {
      color: var(--c-dust);
      margin-top: var(--space-1);
    }

    .work__body {
      display: grid;
      grid-template-columns: 10rem 1fr;
      gap: var(--space-4);
    }

    .work__meta dl div {
      margin-bottom: var(--space-3);
    }

    .work__meta dt {
      color: var(--c-dust);
      font-size: var(--fs-caption);
      letter-spacing: 0.08em;
      margin-bottom: 0.25rem;
    }

    .work__meta dd {
      color: var(--c-fluorescent);
      font-size: var(--fs-small);
      margin-left: 0;
      line-height: 1.6;
    }

    .work__content :global(p) {
      margin-bottom: var(--space-3);
    }

    /*
      本文中の見出し。ラベルとして扱うので小さく、字間を開ける。
      欧文のみで書くこと（--font-mono に和文が無く、混ぜると既定書体に落ちる）。
    */
    .work__content :global(h2) {
      margin-top: var(--space-4);
      margin-bottom: var(--space-2);
      font-family: var(--font-mono);
      font-size: var(--fs-caption);
      font-weight: 400;
      letter-spacing: 0.16em;
      color: var(--c-dust);
      padding-bottom: var(--space-1);
      border-bottom: 1px solid var(--c-facade);
    }

    .work__content :global(ul) {
      margin-bottom: var(--space-3);
      padding-left: 1.1em;
      list-style: disc;
      color: var(--c-dust);
    }

    .work__content :global(li) {
      margin-bottom: 0.35em;
      line-height: 1.9;
    }

    .work__content :global(strong) {
      color: var(--c-fluorescent);
      font-weight: 700;
    }

    /* --- 外部リンク --- */
    .work__links {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-1) var(--space-2);
      margin-top: var(--space-3);
      font-size: var(--fs-caption);
      letter-spacing: 0.06em;
    }

    .work__links a {
      color: var(--c-fluorescent);
      padding: 0.3em 0.7em;
      border: 1px solid var(--c-facade-lit);
      border-radius: var(--radius-button);
      display: inline-block;
      transition: border-color var(--dur-base) var(--ease-inout);
    }

    .work__links a:hover,
    .work__links a:focus-visible {
      border-color: var(--c-signal);
      transition: border-color var(--dur-fast) var(--ease-out);
    }

    .work__back {
      display: inline-block;
      margin-top: var(--space-5);
      color: var(--c-dust);
      font-size: var(--fs-small);
    }

    .work__back:hover,
    .work__back:focus-visible {
      color: var(--c-fluorescent);
    }

    @media (max-width: 640px) {
      .work__body {
        grid-template-columns: 1fr;
      }
    }
  }
</style>
